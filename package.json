{
  "name": "create-ait-app",
  "version": "0.1.3",
  "description": "Create AIT App scaffolding tool",
  "keywords": [
    "ait",
    "apps-in-toss",
    "cli",
    "create-app",
    "react",
    "scaffold",
    "scaffolding",
    "typescript",
    "vite"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toss/create-ait-app.git"
  },
  "bin": "./dist/cli.mjs",
  "files": [
    "dist",
    "skills",
    "templates"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "publint": "publint",
    "test": "vitest run --exclude test/e2e/**",
    "test:e2e": "yarn build && AIT_RUN_E2E=1 vitest run test/e2e",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inquirer/prompts": "8.5.2",
    "create-vite": "9.1.1",
    "cross-spawn": "7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.1.1",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "publint": "0.3.16",
    "release-it": "20.2.1",
    "semver": "7.8.5",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.17.1"
}
